# --- Database (Neon serverless Postgres, or any PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Clerk authentication ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# --- Vercel Blob (private storage for chart captures) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Application ---
# Email of the account bootstrapped with the mentor role
MENTOR_EMAIL="mentor@example.com"
# Absolute base URL used when building invitation links
APP_URL="http://localhost:3000"

# Set to "true" only to allow the seed script to run. Never enable in production.
ALLOW_SEED="false"
